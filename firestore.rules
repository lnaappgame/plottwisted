rules_version = '2';

// Règles de sécurité Firestore — À coller dans la console Firebase :
// Firestore Database → Règles. Couvre les 4 collections réellement utilisées
// par l'app (toute collection non listée ici est implicitement refusée dès
// que ce fichier custom remplace les règles "mode test" par défaut — vérifié
// contre lib/services/{leaderboard_service,cloud_sync_service,
// multiplayer_matchmaking_service}.dart le 2026-09-06).
service cloud.firestore {
  match /databases/{database}/documents {

    // Classement de "L'énigme de la semaine" — lecture publique nécessaire
    // pour calculer le rang et le nombre total de joueurs, y compris pour un
    // joueur qui n'a pas encore lui-même soumis de score cette semaine.
    // Écriture limitée à SON PROPRE document (l'UID anonyme du joueur doit
    // correspondre à l'ID du document), uniquement pour créer un score
    // valide — pas de suppression, pas de modification a posteriori.
    match /enigme_leaderboard/{weekId}/scores/{uid} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.solveSeconds is int
                    && request.resource.data.solveSeconds > 0
                    && request.resource.data.solvedDay is int
                    && request.resource.data.solvedDay >= 1
                    && request.resource.data.solvedDay <= 7;
      allow update, delete: if false;
    }

    // Manches Multijoueur enregistrées — lecture publique nécessaire pour le
    // matching fantôme (un joueur doit pouvoir lire les manches déjà jouées
    // par d'autres pour leur être opposé). L'écriture se fait par `.add()`
    // avec un ID auto-généré (jamais lié à l'UID de l'auteur, voir
    // MultiplayerMatchmakingService.recordRun) : n'importe quel utilisateur
    // authentifié (même anonymement) peut donc créer une manche, à condition
    // que les champs attendus soient du bon type — pas de notion de
    // "propriétaire" possible sur ce document par design. Pas de
    // modification ni de suppression a posteriori.
    match /multiplayer_runs/{enigmeId}/runs/{runId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.eloAtTimeOfPlay is int
                    && request.resource.data.nomJoueur is string;
      allow update, delete: if false;
    }

    // Elo courant par joueur — un document par joueur (contrairement à
    // multiplayer_runs), utilisé uniquement pour le calcul du pourcentage
    // mondial (lecture agrégée sur toute la collection, donc publique).
    // Écriture limitée à SON PROPRE document.
    match /multiplayer_players/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.elo is int;
    }

    // Sauvegarde cloud liée à un compte Google (CloudSyncService.backup/
    // restore) — contient l'intégralité des données de jeu locales de
    // l'utilisateur : contrairement aux classements, PAS de lecture
    // publique. Seul le propriétaire du document (son propre UID Firebase,
    // anonyme ou lié à Google) peut le lire ou l'écraser.
    match /backups/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
