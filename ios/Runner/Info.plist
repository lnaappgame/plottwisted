<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Plot Twist(ed)</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<!-- Langues de l'app (Flutter les gère, mais iOS doit les connaître
	     pour localiser les textes système comme la demande de suivi). -->
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>fr</string>
		</array>
		<key>CFBundleName</key>
		<string>Plot Twist(ed)</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<!-- Connexion Google (sauvegarde cloud) : sans ce schéma d'URL, le
	     retour de la page de connexion Google fait planter l'app. Valeurs
	     reprises de GoogleService-Info.plist (CLIENT_ID / REVERSED_CLIENT_ID). -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.486275850711-8k6khjrvg8vghqootrbjms5sb91tsk7k</string>
				</array>
			</dict>
		</array>
		<key>GIDClientID</key>
		<string>486275850711-8k6khjrvg8vghqootrbjms5sb91tsk7k.apps.googleusercontent.com</string>
		<!-- Seul du HTTPS standard (exempté) : évite la question sur le
	     chiffrement à chaque envoi d'un build à App Store Connect. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- ID d'application AdMob iOS (vrai ID, comme sur Android) : ce sont les
	     ID de blocs (ad_service.dart, REAL_ADS) qui choisissent pubs réelles ou de test. -->
		<key>GADApplicationIdentifier</key>
		<string>ca-app-pub-7543651245365030~9871855193</string>
		<!-- Obligatoire iOS 14.5+ pour toute pub personnalisée (App Tracking
	     Transparency). Texte par défaut (anglais) ; traductions dans
	     en.lproj / fr.lproj/InfoPlist.strings. -->
		<key>NSUserTrackingUsageDescription</key>
		<string>This lets us show you more relevant ads and keep the game free.</string>
		<!-- Identifiant SKAdNetwork de Google, minimum requis pour l'attribution
	     des pubs AdMob sur iOS 14+. À compléter avec la liste complète des
	     réseaux de médiation si des SDK tiers sont ajoutés plus tard (voir
	     https://developers.google.com/admob/ios/ios14). -->
		<key>SKAdNetworkItems</key>
		<array>
			<dict>
				<key>SKAdNetworkIdentifier</key>
				<string>cstr6suwn9.skadnetwork</string>
			</dict>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Portrait uniquement : sans cette clé, Apple refuse le build (erreur
	     90474, le multitâche iPad exigerait toutes les orientations). -->
		<key>UIRequiresFullScreen</key>
		<true/>
	</dict>
</plist>
